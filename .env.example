# ReWoo — environment configuration
# Copy to .env and adjust. NEVER commit your real .env file.

# ── Database ────────────────────────────────────────────────────────────────
# Local development (default): SQLite — zero setup.
DATABASE_URL=file:./db/rewoo.db

# Production / Vercel: use PostgreSQL (Neon, Supabase, Railway, RDS…).
# The db:* scripts and postinstall pick the right Prisma schema automatically:
#   postgres://… → prisma/schema.prisma        (PostgreSQL)
#   file://…     → prisma/schema.sqlite.prisma (SQLite)
# Example (Neon):
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/rewoo?sslmode=require

# ── Credential vault master key ─────────────────────────────────────────────
# AES-256-GCM master key used to encrypt provider API keys at rest.
# REQUIRED on Vercel and other hosted platforms (the filesystem is read-only,
# so the auto-generated dev key file cannot be used).
# Generate one with: openssl rand -hex 32
# REWOO_MASTER_KEY=<64-hex-chars>
