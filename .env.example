# ─── ReWoo configuration ────────────────────────────────────────────────
# Copy this file to `.env` and fill in only what you need.
# Everything is optional: with no keys at all, ReWoo runs on its offline Demo brain.

# Where ReWoo keeps its single database file + uploads
REWOO_DATA_DIR=data
REWOO_HOST=127.0.0.1
REWOO_PORT=8787
# Set this if ReWoo is reachable at a different address (used for Google sign-in redirects)
# REWOO_PUBLIC_URL=http://localhost:8787

# ─── Brains (AI models) — add any, or add them later in Settings → Brains ──
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...
# GROQ_API_KEY=...
# Local & private (free): install https://ollama.com, run `ollama pull llama3.2`
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ─── Google Drive (optional) — see docs/GOOGLE_DRIVE.md ───────────────────
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx

# ─── Engines (optional) — see docs/ENGINES.md ─────────────────────────────
# HERMES_API_URL=http://127.0.0.1:8642/v1
# HERMES_API_KEY=...
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1
# OPENCLAW_GATEWAY_TOKEN=...
# PAPERCLIP_API_URL=http://127.0.0.1:3100
# PAPERCLIP_API_KEY=...

# ─── Security ────────────────────────────────────────────────────────────
# Require a token for the web app + /api (set this before exposing ReWoo beyond localhost)
# REWOO_ACCESS_TOKEN=a-long-random-string
