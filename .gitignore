# ReWoo's own ignores are anchored to the repo root (/…) so they never hide
# source files inside the vendored engines/ (which carry their own .gitignore).
__pycache__/
*.py[cod]
.pytest_cache/
/*.egg-info/
/build/
/dist/
/.venv/
/venv/
/.env
/data/
/*.db
/*.db-wal
/*.db-shm
.DS_Store
/.idea/
/.vscode/
/web/node_modules/
