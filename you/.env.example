# YOU workspace — environment configuration
# Copy to .env and adjust. NEVER commit your real .env.

# SQLite database location (default: ./db/you.db).
# The schema is written PostgreSQL-portably; switch the provider + url in
# prisma/schema.prisma for hosted deployments.
DATABASE_URL=file:./db/you.db

# Master key for the provider credential vault (AES-256-GCM).
# Provide a 64-character hex string for production / persistent self-hosting.
# Generate one with: openssl rand -hex 32
# If unset in development, a local key file (.you-master-key, gitignored)
# is auto-generated with a console warning.
# YOU_MASTER_KEY=<64-hex-chars>
