// ReWoo — PostgreSQL schema (production default: Vercel, Neon, Supabase, Railway, RDS…)
//
// ⚠️ KEEP IN SYNC with prisma/schema.sqlite.prisma (local zero-setup dev).
//    Only the `datasource` block differs. The models are deliberately
//    written portably (no provider-specific column types).
//
// The active schema is selected automatically by scripts/prisma.mjs based on
// the DATABASE_URL protocol: postgres://… → this file, file://… → the SQLite one.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x covers Vercel's Node.js lambda runtime (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ReWoo — open-source AI workspace data model
// Every user-scoped row carries userId; all queries filter by it (tenant
// isolation is enforced at the API layer via the session user).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  providers     ProviderCredential[]
  conversations Conversation[]
}

model Session {
  id        String   @id // SHA-256 hash of the raw cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model ProviderCredential {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // openai | anthropic | gemini | openrouter | groq | mistral | custom
  label           String
  encryptedKey    String // AES-256-GCM ciphertext (never returned by APIs)
  baseUrl         String? // required for custom; optional override for others
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastValidatedAt DateTime?
  lastError       String?

  @@index([userId])
  @@unique([userId, provider, label])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  provider  String? // snapshot of provider used (may change mid-conversation)
  model     String? // snapshot of model used
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  provider       String?
  model          String?
  demo           Boolean  @default(false) // true when produced by the offline demo brain
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime @default(now())

  @@index([conversationId, createdAt])
}
